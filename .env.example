APPLE_TEAM_ID=ABCDE12345
NEXT_PUBLIC_BUNDLE_IDENTIFIER=com.example.yourapp

NEXT_PUBLIC_APP_REDIRECT_URL=yourapp://checkout_redirect/success
NEXT_PUBLIC_PADDLE_ENV=sandbox # or `production`
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# PostHog product analytics (whole site: marketing pages, blog, quiz — ONE project)
NEXT_PUBLIC_POSTHOG_KEY=        # Project API key: posthog.com -> Settings -> Project
# Reverse proxy path — next.config.ts rewrites /ingest -> PostHog US (evades ad blockers).
# For EU region, change the rewrite targets in next.config.ts to eu(-assets).i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# Quiz funnel (/quiz) lead capture — see src/app/api/quiz-lead/route.ts
RESEND_API_KEY=            # Resend API key (sends welcome + notification emails)
RESEND_AUDIENCE_ID=        # Resend Audience to add quiz leads to (the nurture list)
QUIZ_LEAD_NOTIFY_EMAIL=hello@rythma.co  # where the internal "new lead" email (full answers + UTMs) is sent

# Signs the unsubscribe links in quiz emails. Falls back to RESEND_API_KEY if
# unset, but set it explicitly so rotating the Resend key doesn't invalidate
# every unsubscribe link already sitting in people's inboxes.
UNSUBSCRIBE_SECRET=

# Meta Conversions API — the only path by which a lead's email reaches Meta,
# and it goes hashed. Left unset, the CAPI call is skipped entirely.
# META_PIXEL_ID defaults to the pixel hard-coded in app/layout.tsx.
META_CAPI_ACCESS_TOKEN=
META_PIXEL_ID=
# Set only while testing in Events Manager -> Test Events.
META_CAPI_TEST_EVENT_CODE=

# ── Starting Picture funnel (web quiz v3) ───────────────────────────────────
# The 31-screen funnel at /quiz. Unset or not "1" serves the old 14-screen quiz,
# which stays reachable until cutover.
NEXT_PUBLIC_QUIZ_V3=1
# A = Stripe checkout on the web (the decision). B swaps screens 30–31 for a
# single App Store handoff, kept compiling for the day counsel says otherwise.
NEXT_PUBLIC_CHECKOUT_PATH=A

# Stripe (M3). Prices live in src/lib/sp/pricing.ts and are asserted against
# these price objects by scripts/check-stripe-prices.mjs in `prebuild`.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_MONTHLY=

# The app's Supabase functions base URL (M2). Unset = the in-memory mock, so the
# funnel is walkable end to end without the app project.
SP_PROFILE_API_URL=
# Sent as the x-rythma-web-key header on every call to the two web-facing
# functions (web-profile/upsert, web-profile/paid).
SP_PROFILE_API_KEY=
